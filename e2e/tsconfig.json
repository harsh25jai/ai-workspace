{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": "./dist",
    "rootDir": "."
  },
  "include": ["./cli.ts", "./run.ts", "./lib/**/*.ts"],
  "exclude": ["dist", ".workspaces", "reports", "fixtures"]
}
